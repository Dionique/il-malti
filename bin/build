#!/usr/bin/env bash
#
# Assemble the publishable bundle into dist/.
#
# Only the files the browser needs are copied; tools/, tests/, server.js,
# deploy/ and bin/ stay out of the published site.
#
#   bin/build                 # build dist/
#   bin/build --out docs      # build into another folder (GitHub Pages /docs)
#   bin/build --serve         # build and serve it on :8090 for a local check

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="$REPO/dist"
if [ "${1:-}" = "--out" ]; then
  DIST="$REPO/${2:?--out needs a directory}"
fi

FILES=(
  index.html
  styles.css
  app.js
  data/words.js
  data/sentences.js
  data/ipa.js
  data/links.js
  data/pairs.js
)

cd "$REPO"

for f in "${FILES[@]}"; do
  [ -f "$f" ] || { echo "error: missing $f" >&2; exit 1; }
done

rm -rf "$DIST"
mkdir -p "$DIST/data"

for f in "${FILES[@]}"; do
  cp "$f" "$DIST/$f"
done

# Netlify/GitHub Pages serve 404.html; keep it self-contained so it works
# both at the site root and under a sub-path (GitHub Pages project sites).
cat > "$DIST/404.html" <<'HTML'
<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Il-Malti — страница не найдена</title>
<style>
  body { margin:0; background:#f6f4f1; color:#1f2328;
         font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif; }
  main { max-width:780px; margin:0 auto; padding:60px 18px; }
  .box { background:#fff; border:1px solid #e5e1dc; border-left:4px solid #d9a441;
         border-radius:14px; padding:22px; }
  h1 { font-size:20px; margin:0; color:#a9741c; }
  p { color:#6b7280; margin:6px 0 0; }
  a { color:#c8102e; }
</style>
</head><body>
<main><div class="box">
<h1>Страница не найдена</h1>
<p>Похоже, ссылка неверная. <a href="./">Вернуться в приложение</a>.</p>
</div></main></body></html>
HTML

# GitHub Pages skips files starting with an underscore and ignores .nojekyll
# otherwise; harmless for other hosts.
touch "$DIST/.nojekyll"

echo "built $DIST"
find "$DIST" -type f | sed "s|$DIST/|  |" | sort
echo
echo "размер: $(du -sh "$DIST" | cut -f1)"

if [ "${1:-}" = "--serve" ] || [ "${3:-}" = "--serve" ]; then
  echo
  echo "serving http://127.0.0.1:8090/ (Ctrl-C to stop)"
  ( cd "$DIST" && python3 -m http.server 8090 )
fi
